{
	"tasks": {
		"scrape": "deno run --env-file=.env --allow-net --allow-read --allow-write --allow-env engine/scrape.ts",
		"export": "deno run --allow-read --allow-write --allow-env engine/export.ts",
		"serve": "deno run --env-file=.env --allow-net --allow-read --allow-write --allow-env --allow-run=deno web/server.ts",
		"css": "./bin/tailwindcss -i tailwind.css -o static/styles.css --minify",
		"test": "deno test --allow-env --allow-read --allow-write"
	},
	"imports": {
		"@std/assert": "jsr:@std/assert@1"
	},
	"fmt": {
		"useTabs": true,
		"lineWidth": 120,
		"singleQuote": true,
		"semiColons": false,
		"proseWrap": "preserve",
		"exclude": ["data/", "jobs/", "static/", ".vscode/", "deno.lock"]
	},
	"lint": {
		"exclude": ["data/", "jobs/", "static/"]
	}
}
