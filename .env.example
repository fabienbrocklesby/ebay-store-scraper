# Copy this file to .env and fill it in. .env is gitignored: never commit it.
# Both `docker compose up` and `deno task serve` read .env automatically.

# The shared password for the web app. Required.
APP_PASSWORD=

# The Zyte API key (app.zyte.com). Required: every scrape request uses it.
ZYTE_API_KEY=

# --- optional, sensible defaults ---

# PORT=8000
# DATA_DIR=./jobs

# Default per-run spending stop for new jobs, in requests. Leave unset for no
# limit; each job can set its own limit in the app under Technical details.
# MAX_REQUESTS_PER_JOB=

# Measured blended $ per 1,000 Zyte requests (converts the app's dollar limits
# to request budgets). Re-measure in the Zyte dashboard after plan changes.
# COST_PER_1K_USD=0.12

# Parallel requests per job. 160 is the validated sweet spot.
# SCRAPE_CONCURRENCY=160
